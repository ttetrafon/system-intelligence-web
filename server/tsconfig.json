{
	"compilerOptions": {
		/* Base Options: */
		"esModuleInterop": true,
		"skipLibCheck": true,
		"target": "es2024",
		"verbatimModuleSyntax": false,
		"allowJs": true,
		"resolveJsonModule": true,
		"moduleDetection": "force",
		/* Strictness */
		"strict": true,
		"noUncheckedIndexedAccess": true,
		/* If NOT transpiling with TypeScript: */
		"moduleResolution": "Bundler",
		"module": "es2022",
		"noEmit": true,
		"lib": [
			"es2024"
		],
		"types": [
			"./worker-configuration.d.ts",
			"@types/node",
			"node"
		],
		"paths": {
			"lib/*": [
				"../library/*"
			]
		}
	},
	"exclude": [
		"node_modules",
		"dist",
		"tests"
	],
	"include": [
		"src",
		"../library",
		"worker-configuration.d.ts"
	]
}